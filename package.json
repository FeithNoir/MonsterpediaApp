{
  "name": "monsterpedia-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:rules": "firebase emulators:exec --project mosterpedia --only firestore,storage \"node --test tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --project mosterpedia --only auth,firestore,storage \"playwright test\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/fire": "^21.0.0",
    "firebase": "^12.0.0",
    "marked": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0",
    "jsdom": "^27.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.11.0",
    "firebase-tools": "^15.0.0",
    "firebase-admin": "^13.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
