rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.uid == uid;
    }
    match /users/{uid}/entries/{entryId}/{fileId} {
      allow read: if true;
      allow create, update: if owner(uid) && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if owner(uid);
    }
  }
}
